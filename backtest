n_ls = len(LongShortDescs)/2
n_tot = n_fut + n_ls
fut_budget = dv01_budget * n_fut / n_tot
ls_budget = dv01_budget * n_ls / n_tot

##################################################### Run method #####################################################
port_fut = PortfolioMomentum(tickerdescs=FutDescs, budget=fut_budget, AmtInvested=AmountInvested, trade_cost=trade_cost, 
                             data=data, sec_type='futures', relativePnL=False, wait_days=1)
port_ls = PortfolioMomentum(tickerdescs=LongShortDescs, ls_windows=ls_windows, budget=ls_budget, AmtInvested=AmountInvested, 
                            trade_cost=trade_cost_LS, data=data, sec_type='long_short', relativePnL=False, wait_days=1)

fut_pnl = port_fut.consolidate_rtns()[['DailyReturn']].loc[pd.Timestamp(start).date():]
ls_pnl = port_ls.consolidate_rtns()[['DailyReturn']].loc[pd.Timestamp(start).date():]
comb_pnl = fut_pnl + ls_pnl
comb_pnl['CumulativeReturn'] = comb_pnl['DailyReturn'].cumsum()
comb_pnl = comb_pnl / AmountInvested
comb_pnl.index = pd.to_datetime(comb_pnl.index)

comb_pnl_m = comb_pnl[['DailyReturn']].resample('ME').sum()
comb_pnl_m.sort_index(ascending=True, inplace=True)
comb_pnl_m['CumulativeReturn'] = comb_pnl_m['DailyReturn'].cumsum()

