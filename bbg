import pandas as pd
from datetime import datetime
from xbbg import blp

def pull_bbg(tickers, fields, start, end, overrides=None):
    if overrides:
        df = blp.bdh(
            tickers=tickers,
            flds=fields,
            start_date=start,
            end_date=end,
            overrides=overrides
        )
    else:
        df = blp.bdh(
            tickers=tickers,
            flds=fields,
            start_date=start,
            end_date=end
        )
    if hasattr(df, "to_pandas"):
        df = (
            df.to_pandas()
              .pivot(index="date", columns="field", values="value")
              .sort_index()
        )
    elif isinstance(df.columns, pd.MultiIndex):
        df.columns = df.columns.get_level_values(1)
    field_order = [f for f in fields if f in df.columns]
    df = df.reindex(columns=field_order)
    return df

def Get_Multiple_Ticker_BBG_data(tickers, startdate='1960-01-01', enddate=datetime.now().strftime("%Y%m%d")):
    all_data = pd.DataFrame()
    for ticker in tickers:
        if ticker not in ['SFR','ER','COR','SFI','BPSWS2','BPSWS5','BPSWS10','BPSWS30'] :
            ticker_use = ticker + '1 Comdty'
            try:
                df = pull_bbg(tickers=ticker_use, fields=['PX_LAST','FUT_EQV_DUR_NOTL'], start=startdate, end=enddate)
                df = df.reset_index()
                df.columns = ['Date', 'PX_LAST', 'FUT_EQV_DUR_NOTL']
            except:
                print("\n Cannot download the data from Bloomberg for "+ticker)
                continue
            df = df.rename(columns={'PX_LAST': f"{ticker}_mid",
                                    'FUT_EQV_DUR_NOTL': f"{ticker}_Dur"})
            if all_data.empty:
                all_data = df
            else:
                all_data = pd.merge(all_data, df, on='Date', how='outer')
        elif ticker in ['SFR','ER','COR','SFI']:
            ticker_use = ticker + '3 Comdty'
            try:
                df = pull_bbg(tickers=ticker_use, fields=['PX_LAST'], start=startdate, end=enddate)
                df = df.reset_index()
                df.columns = ['Date', 'PX_LAST']
            except:
                print("\n Cannot download the data from Bloomberg for "+ticker)
                continue
            df = df.rename(columns={'PX_LAST': f"{ticker}_offset2_mid"})
            df[f'{ticker}_offset2_Dur'] = 1
            if all_data.empty:
                all_data = df
            else:
                all_data = pd.merge(all_data, df, on='Date', how='outer')
        else:
            ticker_use = ticker + ' Curncy'
            try:
                df = pull_bbg(tickers=ticker_use, fields=['PX_LAST'], start=startdate, end=enddate)
                df = df.reset_index()
                df.columns = ['Date', 'PX_LAST']
            except:
                print("\n Cannot download the data from Bloomberg for "+ticker)
                continue
            df = df.rename(columns={'PX_LAST': f"{ticker_use}_mid",
                                    'SW_EQV_RISK': f"{ticker_use}_Dur"})
            if all_data.empty:
                all_data = df
            else:
                all_data = pd.merge(all_data, df, on='Date', how='outer')
    if not all_data.empty:
        all_data = all_data.sort_values('Date').reset_index(drop=True)
    return all_data


