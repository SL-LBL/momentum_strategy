import pandas as pd
from .momentum_functions import TransformTickerDescs, cross_over_strategy, cross_over_strategy_long_short
from .util_function import plot_cum_rtns, plot_series
from .sql_handler import get_HFRIMTF
import riskfolio as rf


class PortfolioMomentum:
    """
    A class to construct and evaluate a momentum-based futures portfolio.

    Attributes:
        tickerdescs (list): List of ticker descriptors including metadata like notional, weights, and strategy parameters.
        budget (float): Total capital allocated for the portfolio.
        AmtInvested (float): Amount currently invested.
        trade_cost (float): Transaction cost per trade.
        data (pd.DataFrame): Historical price or return data for the tickers.
        sec_type (str): Type of security strategy, e.g., 'long_short'.
        relativePnL (bool): If True, returns are weighted by portfolio allocation.
        decay (bool): If True, apply exponential decay based on decayrate.
        decayrate (float): The exponential decay rate applied to rolling weighted means.
        ls

    Methods:
        run_portfolio():
            Executes the crossover strategy for each ticker and returns a dictionary of PnL results.

        consolidate_rtns_futures():
            Aggregates individual ticker returns into a portfolio-level return DataFrame with daily 
    """
    def __init__(self, tickerdescs, budget, AmtInvested, trade_cost, data, sec_type, relativePnL=False, decay=False, decayrate=None, ls_windows=None):
        self.tickerdescs = tickerdescs
        self.budget = budget
        self.AmtInvested = AmtInvested
        self.trade_cost = trade_cost
        self.data = data
        self.relativePnL = relativePnL
        self.sec_type = sec_type
        transform = TransformTickerDescs(self.tickerdescs, self.budget, self.AmtInvested)
        self.adj_descs = getattr(transform, self.sec_type)()
        self.tickers = transform.tickers()
        self.decay = decay
        self.decayrate=decayrate
        if sec_type == 'long_short':
            self.unpacked = transform.unpack_long_short()
            self.ls_windows = ls_windows

    def run_portfolio(self):
        """
        Runs the crossover strategy for each ticker in the adjusted descriptors.
    
        Returns:
            dict: A dictionary where keys are tickers and values are the result of the crossover strategy, typically including daily returns and other metrics.
        """
        pnls = {}
        if self.sec_type == 'futures':
            for ticker, curr, notional, weight, contracts, dv01, *_, fast, slow in self.adj_descs:
                pnls[ticker] = cross_over_strategy(ticker, curr, notional, contracts, dv01, self.trade_cost, fast, slow, self.data, self.relativePnL, self.decay, self.decayrate)
        elif self.sec_type == 'long_short':
            for pair in self.unpacked.keys():
                name = '_'.join(self.unpacked[pair]['tickers'])+'_spread'
                pnls[name] = cross_over_strategy_long_short(self.unpacked[pair]['tickers'], self.unpacked[pair]['currencies'], self.unpacked[pair]['directions'], \
                                                            self.unpacked[pair]['notionals'], self.unpacked[pair]['contracts'], self.unpacked[pair]['dv01s'], \
                                                            self.trade_cost, self.ls_windows[pair][0], self.ls_windows[pair][1], self.data, self.relativePnL, self.decay, self.decayrate)
        return pnls

    def consolidate_rtns(self):
        """
        Consolidates the individual ticker returns into a single DataFrame.

        Returns:
            pd.DataFrame: A DataFrame with columns for each ticker's daily return, the total daily return, and the cumulative return of the portfolio.
        """
        resultPnL = pd.DataFrame()
        results_dict = self.run_portfolio()
        if self.sec_type == 'futures':
            for ticker, curr, notional, weight, *_ in self.adj_descs:
                if self.relativePnL:
                    resultPnL[f'{ticker}_DailyReturn_unweighed'] = results_dict[ticker]['DailyReturn']
                    resultPnL[f'{ticker}_DailyReturn'] = resultPnL[f'{ticker}_DailyReturn_unweighed']*weight
                else:
                    resultPnL[f'{ticker}_DailyReturn'] = results_dict[ticker]['DailyReturn']
            resultPnL['DailyReturn'] = resultPnL[[f'{ticker}_DailyReturn' for ticker in self.tickers]].sum(axis=1)
        elif self.sec_type == 'long_short':
            for pair in self.unpacked.keys():
                name = '_'.join(self.unpacked[pair]['tickers'])+'_spread'
                weight = sum(abs(wgt) for wgt in self.unpacked[pair]['weights'])
                resultPnL['DailyReturn'] = 0
                if self.relativePnL:
                    resultPnL[f'{name}_DailyReturn_unweighed'] = results_dict[name]['DailyReturn']
                    resultPnL[f'{name}_DailyReturn'] = resultPnL[f'{name}_DailyReturn_unweighed']*weight
                else:
                    resultPnL[f'{name}_DailyReturn'] = results_dict[name]['DailyReturn']
                resultPnL['DailyReturn'] += resultPnL[f'{name}_DailyReturn']
        resultPnL['CumulativeReturn'] = resultPnL['DailyReturn'].cumsum()
        return resultPnL
    
    def update_mvo_weights(self, rfrate=0):
        """
        Updates the portfolio weights and contract allocations using mean-variance optimization.

        Parameters:
        rfrate (float): optional (default=0)

        Workflow:
        1. Computes historical returns for futures if applicable.
        2. Runs mean-variance optimization to determine optimal weights.
        3. Scales current contract allocations based on the optimized weights.
        4. Updates each asset's notional, weight, and contract count in `self.adj_descs`.
        5. Recalculates weights based on the updated notionals to ensure consistency.

        Returns:
        wgt (pd.DataFrame): A DataFrame containing the optimized weights for each asset.
        """
        self.relativePnL = True
        rtns_df = self.consolidate_rtns().filter(like='_DailyReturn_unweighed').dropna()
        port = rf.Portfolio(returns=rtns_df)
        port.assets_stats(method_mu='hist', method_cov='hist')
        port.lowerret = 0
        port.upperret = 1
        wgt = port.optimization(model='Classic', rm='MV', obj='Sharpe', rf=rfrate)
        if self.sec_type == 'futures':
            for i, ticker in enumerate(self.tickers):
                scale = wgt.loc[f'{ticker}_DailyReturn_unweighed', 'weights'] / self.adj_descs[i][3]
                new_contracts = int(self.adj_descs[i][4] * scale)
                new_notional = new_contracts * self.adj_descs[i][6] * self.adj_descs[i][7]
                new_weight = wgt.loc[f'{ticker}_DailyReturn_unweighed', 'weights']
                self.adj_descs[i] = self.adj_descs[i][:2] + (new_notional, new_weight, new_contracts) + self.adj_descs[i][5:]
            total_notional = sum(desc[2] for desc in self.adj_descs)
            for i, ticker in enumerate(self.tickers):
                new_weight = self.adj_descs[i][2] / total_notional
                self.adj_descs[i] = self.adj_descs[i][:3] + (new_weight,) + self.adj_descs[i][4:]
        elif self.sec_type == 'long_short':
            for pair in self.unpacked.keys():
                name = '_'.join(self.unpacked[pair]['tickers'])+'_spread'
                scale = wgt.loc[f'{name}_DailyReturn_unweighed', 'weights'] / sum(abs(wgt) for wgt in self.unpacked[pair]['weights'])
                self.unpacked[pair]['weights'] = [scale*wgt for wgt in self.unpacked[pair]['weights']]
                self.unpacked[pair]['contracts'] = [int(scale*contract) for contract in self.unpacked[pair]['contracts']]
                self.unpacked[pair]['notionals'] = [contract*contract_size for contract, contract_size in zip(self.unpacked[pair]['contracts'], self.unpacked[pair]['contract_sizes'])]
            total_notional = sum([sum([abs(notional) for notional in self.unpacked[pair]['notionals']]) for pair in self.unpacked.keys()])
            for pair in self.unpacked.keys():
                self.unpacked[pair]['weights'] = [notional/total_notional for notional in self.unpacked[pair]['notionals']]
        return wgt

    def compare_HFRIMTF(self, maxLev):
        """
        Compares the portfolio's monthly returns against the HFRI MTF index and generates 
        leveraged return series up to a specified maximum leverage.
    
        Parameters:
        maxLev (int): The maximum leverage multiplier to apply to the portfolio's 1x monthly return.
    
        Returns:
        pd.DataFrame: A DataFrame containing the HFRI MTF monthly returns, the portfolio's 
                      1x monthly returns, and additional columns for 2x to maxLev x leveraged returns.
        """
        hfri = get_HFRIMTF().resample('ME').sum()
        port = self.consolidate_rtns()['DailyReturn'].resample('ME').sum()
        consolidate = pd.concat([hfri, port], axis=1).dropna()
        consolidate.columns = ['HFRIMTF MonRtn', 'Portfolio MonRtn 1x']
        for lev in range(2, maxLev + 1):
            consolidate[f'Portfolio MonRtn {lev}x'] = consolidate['Portfolio MonRtn 1x'] * lev
        return consolidate
    
    def plot_against_HFRIMTF(self, maxLev, startdate):
        """
        Plots the cumulative returns of the strategy against the HFRIMTF benchmark.

        Parameters:
        maxLev (float): The maximum leverage to apply when computing the strategy returns.
        startdate (str): The start date from which to begin plotting the cumulative returns.

        Notes:
        This function uses the `compare_HFRIMTF` method to generate a DataFrame of returns,
        then filters it from the specified start date and plots the cumulative returns.
        The HFRIMTF benchmark is plotted as a dotted line for comparison.
        """
        consolidate = self.compare_HFRIMTF(maxLev=maxLev)
        plot_cum_rtns(consolidate[consolidate.index >= startdate], dotted_series='HFRIMTF MonRtn')
