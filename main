               ('SFR_offset1', 'USD', 1, float("nan"), float("nan"), 1.397, 250000, 20, 60), #3m SOFR, rolled into 2nd contract
               ('SFR_offset2', 'USD', 1, float("nan"), float("nan"), 1.397, 250000, 25, 55), #3m SOFR, rolled into 3rd contract
               ('SFR_offset3', 'USD', 1, float("nan"), float("nan"), 1.397, 250000, 15, 50), #3m SOFR, rolled into 4th contract
               ('SER', 'USD', 1, float("nan"), float("nan"), 1.397, 416700, 7, 25), #1m SOFR
               ('SER_offset1', 'USD', 1, float("nan"), float("nan"), 1.397, 416700, 30, 90), #1m SOFR, rolled into 2nd contract
               ('SER_offset2', 'USD', 1, float("nan"), float("nan"), 1.397, 416700, 20, 50), #1m SOFR, rolled into 3rd contract
               ('SER_offset3', 'USD', 1, float("nan"), float("nan"), 1.397, 416700, 15, 90), #1m SOFR, rolled into 4th contract
               ('COR', 'CAD', 1, float("nan"), float("nan"), 1.000, 250000, 10, 80), #3m CORRA
               ('COR_offset1', 'CAD', 1, float("nan"), float("nan"), 1.000, 250000, 35, 110), #3m CORRA, rolled into 2nd contract
               ('COR_offset2', 'CAD', 1, float("nan"), float("nan"), 1.000, 250000, 35, 110), #3m CORRA, rolled into 3rd contract
               ('COR_offset3', 'CAD', 1, float("nan"), float("nan"), 1.000, 250000, 20, 75), #3m CORRA, rolled into 4th contract
               ]
Descs_adj = TransformTickerDescs(TickerDescs, dv01_budget, AmountInvested)
tickers_list = Descs_adj.tickers()
TickerDescs = Descs_adj.futures()

dfBestWindows = pd.DataFrame(tickers_list, columns=['ticker'], index=tickers_list)
pnls = {}
for ticker, currency, notional, weight, contracts, dv01, *_, fast, slow, in TickerDescs:
    if fix_fx:
        currency = 'CAD'
    pnls[ticker] = PlainEngine.futures_full(ticker, currency, notional, contracts, dv01, trade_cost, data, RelativePnL=relativePnL, decay=decay, decayrate=decayrate)
    select = WindowSelection(ticker, pnls[ticker], fig_path)
    if plot:
        select.plot_heatmaps(save=savefig)
    select.update_dfBestWindows(dfBestWindows, criteria=criteria, cluster=cluster, cluster_size=cluster_n)

if run_CV:
    cv_futures = {}
    for ticker, currency, notional, weight, contracts, dv01, *_, in TickerDescs:
        if fix_fx:
            currency = 'CAD'
        print(f'Processing {ticker}')
        df = data[pd.notnull(data[f'{ticker}_mid'])]
        cv_futures[ticker] = {}
        cv = CrossValidation(PlainEngine, test_weight, df, shares, criteria, cluster=cluster, cluster_size=cluster_n, glue=glue_train)
        cv_futures[ticker]['windows'], cv_futures[ticker]['avgs'] = cv.best_windows(ticker, currency, notional, contracts, dv01, trade_cost, RelativePnL=relativePnL, decay=decay, decayrate=decayrate)
        print(cv_futures[ticker]['windows'])


##################################################### 2-10 SPREAD MOMENTUM #####################################################
#ticker, ccy, CurrentDuration, Direction, Pair#, Weight, MV/Contract, FXRate, ContractSizeLocal, fast_window, slow_window
LongShortDescs = [('TU', 'USD', 1, 1, 1.9159, float("nan"), float("nan"), 1.397, 200000, 10, 50), #long US 2yr
                ('TY', 'USD', -1, 1, 7.7915, float("nan"), float("nan"), 1.397, 100000, 10, 50), #short US 10yr
                ('CV', 'CAD', 1, 2, 1.917, float("nan"), float("nan"), 1.000, 100000, 10, 50), #long CA 2yr
                ('CN', 'CAD', -1, 2, 7.9259, float("nan"), float("nan"), 1.000, 100000, 10, 50), #short CA 10yr
                ('DU', 'EUR', 1, 3, 1.9453, float("nan"), float("nan"), 1.568, 100000, 10, 50), #long EU 2yr
                ('RX', 'EUR', -1, 3, 8.1062, float("nan"), float("nan"), 1.568, 100000, 10, 50), #short EU 10yr
                ('BPSWS2 Curncy', 'GBP', 1, 4, 1.918, float("nan"), float("nan"), 1.8592, 100000, 20, 110), #long UK 2yr SONIA (ContractSize is a dummy for compatibility)
                ('BPSWS10 Curncy', 'GBP', -1, 4, 8.187, float("nan"), float("nan"), 1.8592, 100000, 20, 110), #short UK 10yr SONIA (ContractSize is a dummy for compatibility)
                ]
LongShortDescs_adj = TransformTickerDescs(LongShortDescs, dv01_budget, AmountInvested)
tickers_list = LongShortDescs_adj.tickers()
LongShortDict = LongShortDescs_adj.unpack_long_short()

dfBestWindows_LS = pd.DataFrame(columns=['ticker'])
pnls_LS = {}
for pair in LongShortDict.keys():
    tickers = LongShortDict[pair]['tickers']
    currencies = LongShortDict[pair]['currencies']
    if fix_fx:
        currencies = ['CAD','CAD']
    directions = LongShortDict[pair]['directions']
    notionals = LongShortDict[pair]['notionals']
    contracts = LongShortDict[pair]['contracts']
    dv01s = LongShortDict[pair]['dv01s']
    name = '_'.join(tickers)+'_spread'
    pnls_LS[name] = LSEngine.long_short_full(tickers, currencies, directions, notionals, contracts, dv01s, trade_cost_LS, data, RelativePnL=relativePnL, decay=decay, decayrate=decayrate)
    select = WindowSelection(name, pnls_LS[name], fig_path)
    if plot:
        select.plot_heatmaps(save=savefig)
    select.update_dfBestWindows(dfBestWindows_LS, criteria=criteria, cluster=cluster, cluster_size=cluster_n)

if run_CV:
    cv_LS = {}
    for pair in LongShortDict.keys():
        tickers = LongShortDict[pair]['tickers']
        currencies = LongShortDict[pair]['currencies']
        if fix_fx:
            currencies = ['CAD','CAD']
        directions = LongShortDict[pair]['directions']
        notionals = LongShortDict[pair]['notionals']
        contracts = LongShortDict[pair]['contracts']
        dv01s = LongShortDict[pair]['dv01s']
        name = '_'.join(tickers)+'_spread'
        print(f'Processing {name}')
        df = data[pd.notnull(data[f'{tickers[0]}_mid']) & pd.notnull(data[f'{tickers[1]}_mid'])]
        cv_LS[name] = {}
        cv = CrossValidation(LSEngine, test_weight, df, shares, criteria=criteria, cluster=cluster, cluster_size=cluster_n, glue=glue_train)
        cv_LS[name]['windows'], cv_LS[name]['avgs'] = cv.best_windows_LS(tickers, currencies, directions, notionals, contracts, dv01s, trade_cost_LS, RelativePnL=relativePnL, decay=decay, decayrate=decayrate)
        print(cv_LS[name]['windows'])


