    cv_cc5 = {}
    for pair in CrossCurDict5.keys():
        tickers = CrossCurDict5[pair]['tickers']
        currencies = CrossCurDict5[pair]['currencies']
        if fix_fx:
            currencies = ['CAD','CAD']
        directions = CrossCurDict5[pair]['directions']
        notionals = CrossCurDict5[pair]['notionals']
        contracts = CrossCurDict5[pair]['contracts']
        dv01s = CrossCurDict5[pair]['dv01s']
        name = '_'.join(tickers)+'_spread'
        print(f'Processing {name}')
        df = data[pd.notnull(data[f'{tickers[0]}_mid']) & pd.notnull(data[f'{tickers[1]}_mid'])]
        cv_cc5[name] = {}
        cv = CrossValidation(Engine, test_weight, df, shares, criteria=criteria_LS, cluster=cluster, cluster_size=cluster_n, glue=glue_train)
        cv_cc5[name]['windows'], cv_cc5[name]['avgs'] = cv.best_windows_LS(tickers, currencies, directions, notionals, contracts, dv01s, 
                                                                           trade_cost_LS, RelativePnL=relativePnL, decay=decay, decayrate=decayrate)
        print(cv_cc5[name]['windows'])

