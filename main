import os
from support_codes.model_selection import *
from support_codes.consolidate_portfolio import *


##################################################### SETTINGS #####################################################
# Backtest Settings
AmountInvested = 100000000 # Target notional in CAD
dv01_budget = 27000 # In CAD
trade_cost = 0.20 # In bps
trade_cost_LS = 0.15 # In bps
fix_fx = True # Toggle to keep FX rates fixed

# Cross Over Scenarios Engine Settings
PlainEngine = CrossOverScenarios(max_fast=50, max_slow=200, skip=1)
LSEngine = CrossOverScenarios(max_fast=100, max_slow=300, skip=2)
relativePnL = True # Toggle to generate returns in % or in $Amt
decay = True # Toggle to exponentially decay longer history to give more weight to recent data
decayrate = 0.005 # Exponential decay rate if previous toggle is True

# Data Source and Filepath Settings
bbg_data = False #Toggle to pull from BBG API or pull data from Excel files
path = os.getcwd()
data_path = os.path.join(path, 'Data', 'futures data.xlsx') # Comment out if pulling directly from BBG
fx_path = os.path.join(path, 'Data', 'DM FX data.xlsx') # Comment out if pulling directly from BBG
rates_path = os.path.join(path, 'Data', 'DM rates history.xlsx') # Comment out if pulling directly from BBG

# Plotting Settings
plot = False # Toggle to plot 5 heatmaps for each security or pair 
savefig = False # Toggle to save heatmaps in "fig_path"
fig_path = os.path.join(path, 'Figures') # File path to save heatmaps

# Model Selection Settings
criteria = 'sharpe' # Window selection criteria
cluster = True # Toggle to use clustering to select windows
cluster_n = 5 # Cluster matrix size
run_CV = True # Toggle to run cross-validation based on parameters below 
test_weight = 0.5 # Leave-out sample sharpe has x% weight
shares = 5 # Number of shares to slice total data. Training% = (shares-1)/shares; Testing% = 1/shares
glue_train = False # Toggle to glue training sample

# Pandas Settings
pd.set_option('mode.chained_assignment', None) # Disable pandas warning for not modifying original dataframe
pd.set_option('expand_frame_repr', False) # Print dataframes in a single line if it fits
pd.set_option('display.max_columns', 15) # Truncate middle columns if len(df.columns) > 15


##################################################### LOADING DATA #####################################################
############################################## IGNORE IF PULLING FROM BBG ##############################################
if bbg_data:
    from support_codes.bbg import *
    ### Adapt to pull from BBG

else:
    sheet_names = pd.ExcelFile(data_path).sheet_names
    data = pd.DataFrame(columns=['Date'])
    for sheet in sheet_names[1:]:
        df = pd.read_excel(data_path, sheet_name=sheet, engine='openpyxl')
        if sheet.endswith(" Curncy"):
            df = df[['Date', 'PX_LAST', 'PX_BID', 'PX_ASK']]
            df.columns = ['Date', f'{sheet}_mid', f'{sheet}_bid', f'{sheet}_ask']
        else:
            df = df[['Date', 'PX_LAST', 'PX_BID', 'PX_ASK', 'FUT_EQV_DUR_NOTL']]
            df.columns = ['Date', f'{sheet}_mid', f'{sheet}_bid', f'{sheet}_ask', f'{sheet}_Dur']
        df['Date'] = pd.to_datetime(df['Date'])
        data = pd.merge(data, df, on='Date', how='outer')

    sheet_names = pd.ExcelFile(fx_path).sheet_names
    for sheet in sheet_names:
        df = pd.read_excel(fx_path, sheet_name=sheet, engine='openpyxl')
        df.columns = ['Date', f'{sheet}']
        df['Date'] = pd.to_datetime(df['Date'])
        data = pd.merge(data, df, on='Date', how='outer')

    data_oos = data[data['Date'] <= '2008-01-01']
    data = data[(data['Date'] >= '2007-01-01') & (data['Date'] <= '2025-04-30')]
    data[['SFR_Dur','SFR_offset1_Dur','SFR_offset2_Dur','SFR_offset3_Dur','SER_Dur','SER_offset1_Dur','SER_offset2_Dur','SER_offset3_Dur','COR_Dur','COR_offset1_Dur','COR_offset2_Dur','COR_offset3_Dur','OOR_Dur']] = 1
    # Force SOFR and CORRA duration to 1 for compatibility with functions



##################################################### SELECTED FUTURES #####################################################
#ticker, ccy, CurrentDuration, Weight, MV/Contract, FXRate, ContractSizeLocal, fast_window, slow_window
#Set ccy to CAD if we want constant-FX returns
FutDescs = [('TU', 'CAD', 1.9159, float("nan"), float("nan"), 1.397, 200000, 25, 65), #US 2yr
            ('FV', 'CAD', 4.4194, float("nan"), float("nan"), 1.397, 100000, 20, 50), #US 5yr
            ('UXY', 'CAD', 7.8153, float("nan"), float("nan"), 1.397, 100000, 20, 45), #US ultra 10yr
            ('WN', 'CAD', 15.352, float("nan"), float("nan"), 1.397, 100000, 15, 55), #US ultra t-bond
            ('CV', 'CAD', 1.917, float("nan"), float("nan"), 1.000, 100000, 25, 55), #CA 2yr
            ('XQ', 'CAD', 4.4424, float("nan"), float("nan"), 1.000, 100000, 10, 70), #CA 5yr
            ('DU', 'CAD', 1.9453, float("nan"), float("nan"), 1.568, 100000, 20, 70), #EU 2yr
            ('OE', 'CAD', 4.5144, float("nan"), float("nan"), 1.568, 100000, 20, 70), #EU 5yr
            ('BPSWS2 Curncy', 'CAD', 1.918, float("nan"), float("nan"), 1.8592, 100000, 30, 80), #UK 2yr SONIA
            ('BPSWS5 Curncy', 'CAD', 4.532, float("nan"), float("nan"), 1.8592, 100000, 30, 105), #UK 5yr SONIA
            ('BPSWS10 Curncy', 'CAD', 8.187, float("nan"), float("nan"), 1.8592, 100000, 35, 105), #UK 10yr SONIA
            ('SFR_offset2', 'CAD', 1, float("nan"), float("nan"), 1.397, 250000, 25, 55), #3m SOFR, rolled into 3rd contract
            ('SER_offset2', 'CAD', 1, float("nan"), float("nan"), 1.397, 416700, 20, 50), #1m SOFR, rolled into 3rd contract
            ('COR_offset2', 'CAD', 1, float("nan"), float("nan"), 1.000, 250000, 35, 110), #3m CORRA, rolled into 3rd contract
            ]

# Equal DV01 budget
port = PortfolioMomentum(FutDescs, dv01_budget, AmountInvested, trade_cost, data, 'futures', relativePnL=relativePnL)
port.plot_against_HFRIMTF(maxLev=5, startdate='2021-01-01')
print(performance_metrics(port.consolidate_rtns_futures()[port.consolidate_rtns_futures().index >= '2021-01-01']))
portdecay = PortfolioMomentum(FutDescs, dv01_budget, AmountInvested, trade_cost, data, 'futures', relativePnL=relativePnL, decay=decay, decayrate=decayrate)
portdecay.plot_against_HFRIMTF(maxLev=5, startdate='2021-01-01')
print(performance_metrics(portdecay.consolidate_rtns_futures()[portdecay.consolidate_rtns_futures().index >= '2021-01-01']))

rtns = {}
for ticker, currency, notional, weight, contracts, dv01, *_, fast, slow in port.adj_descs:
    if fix_fx:
        currency = 'CAD'
    rtns[ticker] = cross_over_strategy(ticker, currency, notional, contracts, dv01, trade_cost, fast, slow, data, RelativePnL=relativePnL)
    if len(rtns[ticker]) > 0:
        print(f'{ticker} no decay')
        print(performance_metrics(rtns[ticker]))
        print('Cumulative Return', rtns[ticker].loc[str(rtns[ticker].index.max()),'CumulativeReturn'])
    rtns[f'{ticker} decay'] = cross_over_strategy(ticker, currency, notional, contracts, dv01, trade_cost, fast, slow, data, RelativePnL=relativePnL, decay=decay, decayrate=decayrate)
    if len(rtns[f'{ticker} decay']) > 0:
        print(f'{ticker} with decay')
        print(performance_metrics(rtns[f'{ticker} decay']))
        print('Cumulative Return', rtns[f'{ticker} decay'].loc[str(rtns[f'{ticker} decay'].index.max()),'CumulativeReturn'])
        print()
    plot_cum_rtns(pd.DataFrame(rtns[ticker]['DailyReturn']), title=ticker, fname='Save', additive=True, save=False)
    plot_cum_rtns(pd.DataFrame(rtns[f'{ticker} decay']['DailyReturn']), title=f'{ticker} decay', fname='Save', additive=True, save=False)

# Update weights using MVO
port.update_mvo_weights()
port.plot_against_HFRIMTF(maxLev=5, startdate='2021-01-01')
print(performance_metrics(port.consolidate_rtns_futures()[port.consolidate_rtns_futures().index >= '2021-01-01']))
portdecay.update_mvo_weights()
portdecay.plot_against_HFRIMTF(maxLev=5, startdate='2021-01-01')
print(performance_metrics(portdecay.consolidate_rtns_futures()[portdecay.consolidate_rtns_futures().index >= '2021-01-01']))


