TickerDescs = [#('TU', 'USD', 1.9159, float("nan"), float("nan"), 1.397, 200000, 20, 50), #US 2yr
               #('FV', 'USD', 4.4194, float("nan"), float("nan"), 1.397, 100000, 20, 50), #US 5yr
