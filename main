import os
from support_codes.model_selection import *
from support_codes.consolidate_portfolio import *


##################################################### SETTINGS #####################################################
# Backtest Settings
AmountInvested = 100000000 # Target notional in CAD
dv01_budget = 27000 # In CAD
trade_cost = 0.20 # In bps
trade_cost_LS = 0.15 # In bps
fix_fx = True # Toggle to keep FX rates fixed

# Cross Over Scenarios Engine Settings
Engine = CrossOverScenarios(fast_start=5, slow_start=20, max_fast=50, max_slow=200, skip=10, momentum_2nd=True, ignore_1st_order=False,
                            slowslope_start=5, fastslope_start=10, max_slopefast=50, max_slopeslow=150, skip_slope=10, 
                            buffer_start=0.0, max_buffer=0.0, skip_buffer=0.1, deviation=True, r2=True, dev_r2=True,
                            dynamic_alloc=True)
relativePnL = True # Toggle to generate returns in % or in $Amt
decay = False # Toggle to exponentially decay longer history to give more weight to recent data
decayrate = 0.01 # Exponential decay rate if previous toggle is True

# Data Source and Filepath Settings
bbg_data = False #Toggle to pull from BBG API or pull data from Excel files
path = os.getcwd()
data_path = os.path.join(path, 'Data', 'futures data.xlsx') # Local file
fx_path = os.path.join(path, 'Data', 'DM FX data.xlsx') # Local file
rates_path = os.path.join(path, 'Data', 'DM rates history.xlsx') # Local file

# Plotting Settings
plot = False # Toggle to plot 5 heatmaps for each security or pair 
savefig = False # Toggle to save heatmaps in "fig_path"
fig_path = os.path.join(path, 'Figures') # File path to save heatmaps

# Model Selection Settings
criteria_fut = 'sharpe_dev' # Window selection criteria for futures
criteria_LS = 'sharpe' # Window selection criteria for pairs
cluster = False # Toggle to use clustering to select windows
cluster_n = 9 # Cluster matrix size
run_CV = True # Toggle to run cross-validation based on parameters below 
test_weight = 0.5 # Leave-out sample sharpe has x% weight
shares = 4 # Number of shares to slice total data. Training% = (shares-1)/shares; Testing% = 1/shares
glue_train = False # Toggle to glue training sample

# Pandas Settings
pd.set_option('mode.chained_assignment', None) # Disable pandas warning for not modifying original dataframe
pd.set_option('expand_frame_repr', False) # Print dataframes in a single line if it fits
pd.set_option('display.max_columns', 15) # Truncate middle columns if len(df.columns) > 15


##################################################### LOADING DATA #####################################################
############################################## IGNORE IF PULLING FROM BBG ##############################################
if bbg_data:
    from support_codes.bbg import *
    ### Adapt to pull from BBG

else:
    sheet_names = pd.ExcelFile(data_path).sheet_names
    data = pd.DataFrame(columns=['Date'])
    for sheet in sheet_names[1:]:
        df = pd.read_excel(data_path, sheet_name=sheet, engine='openpyxl')
        if sheet.endswith(" Curncy"):
            df = df[['Date', 'PX_LAST', 'PX_BID', 'PX_ASK']]
            df.columns = ['Date', f'{sheet}_mid', f'{sheet}_bid', f'{sheet}_ask']
        else:
            df = df[['Date', 'PX_LAST', 'PX_BID', 'PX_ASK', 'FUT_EQV_DUR_NOTL']]
            df.columns = ['Date', f'{sheet}_mid', f'{sheet}_bid', f'{sheet}_ask', f'{sheet}_Dur']
        df['Date'] = pd.to_datetime(df['Date'])
        data = pd.merge(data, df, on='Date', how='outer')

    sheet_names = pd.ExcelFile(fx_path).sheet_names
    for sheet in sheet_names:
        df = pd.read_excel(fx_path, sheet_name=sheet, engine='openpyxl')
        df.columns = ['Date', f'{sheet}']
        df['Date'] = pd.to_datetime(df['Date'])
        data = pd.merge(data, df, on='Date', how='outer')

    data_oos = data[data['Date'] <= '2008-01-01']
    data = data[data['Date'] >= '2007-01-01']
    data[['SFR_Dur','SFR_offset1_Dur','SFR_offset2_Dur','SFR_offset3_Dur','SER_Dur','SER_offset1_Dur','SER_offset2_Dur',
          'SER_offset3_Dur','COR_Dur','COR_offset1_Dur','COR_offset2_Dur','COR_offset3_Dur','OOR_Dur','SFI_Dur','SFI_offset1_Dur',
          'SFI_offset2_Dur','SFI_offset3_Dur','ER_Dur','ER_offset1_Dur','ER_offset2_Dur','ER_offset3_Dur']] = 1
    # Force overnight duration to 1 for compatibility with functions


##################################################### Determine Windows #####################################################
######################################################### | | | | | #########################################################
######################################################## \/\/\/\/\/ #########################################################

##################################################### FUTURES MOMENTUM #####################################################
#ticker, ccy, CurrentDuration, Weight, MV/Contract, FXRate, ContractSizeLocal, fast_window, slow_window, fast_slope, slow_slope, buffer
TickerDescs = [
               ('TU', 'CAD', 1.9159, float("nan"), float("nan"), 1.397, 200000, 25, 50, 30, 145, 0.0), #US 2yr
               ('FV', 'CAD', 4.4194, float("nan"), float("nan"), 1.397, 100000, 25, 50, 30, 145, 0.0), #US 5yr
            #    ('TY', 'CAD', 7.7915, float("nan"), float("nan"), 1.397, 100000, 25, 195, 20, 115, -1), #US 10yr
               ('UXY', 'CAD', 7.8153, float("nan"), float("nan"), 1.397, 100000, 15, 50, 30, 35, 0.0), #US ultra 10yr
               ('CV', 'CAD', 1.917, float("nan"), float("nan"), 1.000, 100000, 25, 50, 10, 115, 0.0), #CA 2yr
               ('XQ', 'CAD', 4.4424, float("nan"), float("nan"), 1.000, 100000, 15, 50, 20, 45, 0.0), #CA 5yr
               ('CN', 'CAD', 7.9259, float("nan"), float("nan"), 1.000, 100000, 15, 60, 20, 35, 0.0), #CA 10yr
               ('DU', 'CAD', 1.9453, float("nan"), float("nan"), 1.568, 100000, 25, 70, 30, 45, 0.0), #EU 2yr
               ('OE', 'CAD', 4.5144, float("nan"), float("nan"), 1.568, 100000, 45, 160, 50, 85, 0.0), #EU 5yr
               ('BPSWS2 Curncy', 'CAD', 1.918, float("nan"), float("nan"), 1.8592, 100000, 35, 90, 50, 145, 0.0), #UK 2yr SONIA (ContractSize is a dummy for compatibility)
               ('BPSWS5 Curncy', 'CAD', 4.532, float("nan"), float("nan"), 1.8592, 100000, 35, 100, 10, 25, 0.0), #UK 5yr SONIA (ContractSize is a dummy for compatibility)
               ('BPSWS10 Curncy', 'CAD', 8.187, float("nan"), float("nan"), 1.8592, 100000, 15, 200, 50, 145, 0.0), #UK 10yr SONIA (ContractSize is a dummy for compatibility)
               ('SFR_offset2', 'CAD', 1, float("nan"), float("nan"), 1.397, 250000, 25, 50, 40, 125, 0.0), #3m SOFR, rolled into 3rd contract
               ('COR_offset2', 'CAD', 1, float("nan"), float("nan"), 1.000, 250000, 35, 130, 10, 135, 0.0), #3m CORRA, rolled into 3rd contract
               ('SFI_offset2', 'CAD', 1, float("nan"), float("nan"), 1.8592, 250000, 5, 20, 10, 145, 0.0), #3m SONIA, rolled into 3rd contract
               ('ER_offset2', 'CAD', 1, float("nan"), float("nan"), 1.5681, 250000, 5, 100, 20, 25, 0.0), #3m EURIBOR, rolled into 3rd contract
               ]
Descs_adj = TransformTickerDescs(TickerDescs, dv01_budget, AmountInvested)
tickers_list = Descs_adj.tickers()
Tickerdescs = Descs_adj.futures()

## In-sample best parameters (output stored as json and csv)
store_params = pd.DataFrame(index=tickers_list)
pnls = {}
for ticker, currency, notional, weight, contracts, dv01, *_, fast, slow, in Tickerdescs:
    print(f'Processing {ticker}')
    if fix_fx:
        currency = 'CAD'
    scenarios = Engine.futures_simplified(ticker, currency, notional, contracts, dv01, trade_cost, data, RelativePnL=relativePnL, decay=decay, decayrate=decayrate)
    pnls[ticker] = scenarios
    idx = scenarios[criteria_fut].idxmax()
    if store_params.empty:
        store_params = pd.DataFrame(columns=scenarios.columns, index=tickers_list)
    store_params.loc[ticker, :] = scenarios.loc[idx]

## Generating lower dimension views 
view = 'sharpe'
for ticker in tickers_list:
    print(ticker)
    wind_view = pnls[ticker].pivot_table(index='slow_window', columns='fast_window', values=view)
    plot_3d_surface(wind_view, f'{ticker} {view} window view', xlabel='Fast', ylabel='Slow')
    # plot_heatmap(wind_view)
    slope_view = pnls[ticker].pivot_table(index='slow_slope', columns='fast_slope', values=view)
    plot_3d_surface(slope_view, f'{ticker} {view} slope view', xlabel='Fast', ylabel='Slow')
    # plot_heatmap(slope_view)
    buffer_view = pnls[ticker].pivot_table(index='buffer', values=view)
    print(buffer_view)

## Plotting individuals with optimized (very overfitted but just for visualization) parameters
results = {}
for i, ticker in enumerate(store_params.index):
    result = cross_over_strategy(Tickerdescs[i][0], Tickerdescs[i][1], Tickerdescs[i][2], Tickerdescs[i][4], Tickerdescs[i][5], 
                                 trade_cost, store_params.loc[ticker,'fast_window'], store_params.loc[ticker,'slow_window'], data, 
                                 momentum_2nd=True, fast_slope=store_params.loc[ticker,'fast_slope'],slow_slope=store_params.loc[ticker,'slow_slope'],
                                 buffer_2nd=store_params.loc[ticker,'buffer'],RelativePnL=relativePnL, ignore_1st_order=False, dynamic_alloc=True)
    results[ticker] = result
    print(f'{ticker} Best Possible Results:')
    print(performance_metrics(result, deviation=True, r2=True, dev_r2=True))
    plot_cum_rtns(pd.DataFrame(result['DailyReturn']))

## Best performance achievable (in-sample optimization w/ in-sample test):
fut_best = PortfolioMomentum(TickerDescs, dv01_budget, AmountInvested, trade_cost, data, 'futures', relativePnL=relativePnL, 
                             momentum_2nd_order=True, ignore_1st_order=False, dynamic_alloc=True)
print(performance_metrics(fut_best.consolidate_rtns(), r2=True))
fut_best.plot_against_HFRIMTF(maxLev=5, startdate='2008-01-01')

## Reducing overfit with cross-validation
if run_CV:
    cv_futures = {}
    for ticker, currency, notional, weight, contracts, dv01, *_, in Tickerdescs:
        if fix_fx:
            currency = 'CAD'
        print(f'Processing {ticker}')
        df = data[pd.notnull(data[f'{ticker}_mid'])]
        cv_futures[ticker] = {}
        cv = CrossValidation(Engine, test_weight, df, shares, criteria_fut, cluster=False, cluster_size=cluster_n, glue=glue_train)
        cv_futures[ticker]['windows'], cv_futures[ticker]['avgs'] = cv.best_windows(ticker, currency, notional, contracts, dv01, 
                                                                                    trade_cost, RelativePnL=relativePnL, decay=decay, 
                                                                                    decayrate=decayrate)
        print(cv_futures[ticker]['windows'])
for key in cv_futures.keys():
    print(cv_futures[key]['windows'])
# port = PortfolioMomentum(TickerDescs, dv01_budget, AmountInvested, trade_cost, data, 'futures', relativePnL=relativePnL).run_portfolio()
# for tick in port.keys():
