               ('CN', 'CAD', 7.9259, float("nan"), float("nan"), 1.000, 100000, 10, 60), #CA 10yr
               ('DU', 'EUR', 1.9453, float("nan"), float("nan"), 1.568, 100000, 20, 70), #EU 2yr
               ('OE', 'EUR', 4.5144, float("nan"), float("nan"), 1.568, 100000, 20, 70), #EU 5yr
