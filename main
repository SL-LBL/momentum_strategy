#     print(performance_metrics(port[tick]))
#     plot_cum_rtns(pd.DataFrame(port[tick]['DailyReturn']))


##################################################### 2-10 SPREAD MOMENTUM #####################################################
#ticker, ccy, CurrentDuration, Direction, Pair#, Weight, MV/Contract, FXRate, ContractSizeLocal, fast_window, slow_window
LongShortDescs = [('TU', 'USD', 1, 1, 1.9159, float("nan"), float("nan"), 1.397, 200000), #long US 2yr
                  ('TY', 'USD', -1, 1, 7.7915, float("nan"), float("nan"), 1.397, 100000), #short US 10yr
                  ('CV', 'CAD', 1, 2, 1.917, float("nan"), float("nan"), 1.000, 100000), #long CA 2yr
                  ('CN', 'CAD', -1, 2, 7.9259, float("nan"), float("nan"), 1.000, 100000), #short CA 10yr
                  ('DU', 'EUR', 1, 3, 1.9453, float("nan"), float("nan"), 1.568, 100000), #long EU 2yr
                  ('RX', 'EUR', -1, 3, 8.1062, float("nan"), float("nan"), 1.568, 100000), #short EU 10yr
                  ('BPSWS2 Curncy', 'GBP', 1, 4, 1.918, float("nan"), float("nan"), 1.8592, 100000), #long UK 2yr SONIA (ContractSize is a dummy for compatibility)
                  ('BPSWS10 Curncy', 'GBP', -1, 4, 8.187, float("nan"), float("nan"), 1.8592, 100000), #short UK 10yr SONIA (ContractSize is a dummy for compatibility)
                  ]
LongShortDescs_adj = TransformTickerDescs(LongShortDescs, dv01_budget, AmountInvested)
tickers_list = LongShortDescs_adj.tickers()
LongShortDict = LongShortDescs_adj.unpack_long_short()

## In-sample best parameters (output stored as json and csv)
store_params_LS = pd.DataFrame(index=tickers_list)
pnls_LS = {}
for pair in LongShortDict.keys():
    tickers = LongShortDict[pair]['tickers']
    currencies = LongShortDict[pair]['currencies']
    if fix_fx:
        currencies = ['CAD','CAD']
    directions = LongShortDict[pair]['directions']
    notionals = LongShortDict[pair]['notionals']
    contracts = LongShortDict[pair]['contracts']
    dv01s = LongShortDict[pair]['dv01s']
    name = '_'.join(tickers)+'_spread'
    scenarios = Engine.long_short_simplified(tickers, currencies, directions, notionals, contracts, dv01s, trade_cost_LS,
                                               data, RelativePnL=relativePnL, decay=decay, decayrate=decayrate)
    pnls_LS[name] = scenarios
    idx = scenarios[criteria_LS].idxmax()
    if store_params_LS.empty:
        store_params_LS = pd.DataFrame(columns=scenarios.columns)
    store_params_LS.loc[name, :] = scenarios.loc[idx]
# store_json(pnls_LS, '2-10 in_sample.json')

## Generating lower dimension views 
view = 'sharpe'
for key in pnls_LS.keys():
    print(key)
    wind_view = pnls_LS[key].pivot_table(index='slow_window', columns='fast_window', values=view)
    plot_3d_surface(wind_view, f'{key} {view} window view', xlabel='Fast', ylabel='Slow')
    # plot_heatmap(wind_view)
    slope_view = pnls_LS[key].pivot_table(index='slow_slope', columns='fast_slope', values=view)
    plot_3d_surface(slope_view, f'{key} {view} slope view', xlabel='Fast', ylabel='Slow')
    # plot_heatmap(slope_view)
    buffer_view = pnls_LS[key].pivot_table(index='buffer', values=view)
    print(buffer_view)

## Reducing overfit with cross-validation
if run_CV:
    cv_LS = {}
    for pair in LongShortDict.keys():
        tickers = LongShortDict[pair]['tickers']
        currencies = LongShortDict[pair]['currencies']
        if fix_fx:
            currencies = ['CAD','CAD']
        directions = LongShortDict[pair]['directions']
        notionals = LongShortDict[pair]['notionals']
        contracts = LongShortDict[pair]['contracts']
        dv01s = LongShortDict[pair]['dv01s']
        name = '_'.join(tickers)+'_spread'
        print(f'Processing {name}')
        df = data[pd.notnull(data[f'{tickers[0]}_mid']) & pd.notnull(data[f'{tickers[1]}_mid'])]
        cv_LS[name] = {}
        cv = CrossValidation(Engine, test_weight, df, shares, criteria=criteria_LS, cluster=cluster, cluster_size=cluster_n, glue=glue_train)
        cv_LS[name]['windows'], cv_LS[name]['avgs'] = cv.best_windows_LS(tickers, currencies, directions, notionals, contracts, dv01s, trade_cost_LS, 
                                                                         RelativePnL=relativePnL, decay=decay, decayrate=decayrate)
        print(cv_LS[name]['windows'])

windows = {
              1: [15, 40],
              2: [15, 50],
              3: [25, 80],
              4: [20, 60],
              }

port_ls = PortfolioMomentum(tickerdescs=LongShortDescs, budget=dv01_budget, AmtInvested=AmountInvested, trade_cost=trade_cost_LS, 
                            data=data, sec_type='long_short', ls_windows=windows, relativePnL=relativePnL, decay=False, 
                            decayrate=0.005, conditional_decay=True, condition=[100,300]).run_portfolio()

for name in port_ls.keys():
    print(name)
    print(performance_metrics(port_ls[name]))
    plot_cum_rtns(pd.DataFrame(port_ls[name]['DailyReturn']))


