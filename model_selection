################################################# For Optimizing #################################################
class WindowSelection:
    """
    Initialize the WindowSelection class with ticker and pnls data (from the previous class).

    Parameters:
    ticker (str): The ticker symbol for the asset.
    pnls (pd.DataFrame): The DataFrame containing pnl data.
    dirpath (str): The path to save output figures.
    """
    def __init__(self, ticker, pnls, dirpath):
        self.ticker = ticker
        self.pnls = pnls
        self.dirpath = dirpath

    def plot_heatmaps(self, save=False, save_name='Trade_strategy_heatmap_plots'):
        """
        Function to plot heatmaps for different lookback sharpe ratios.
        
        Parameters:
        save (bool): If True, save the plot to a file. Default is False.
        save_name (str): The name of the file to save the plot.
    
        Returns:
        None
        """
        sns.set_style("darkgrid", {"axes.facecolor": ".9"})
        fig = plt.figure(figsize=(20, 60))
        for i, period in enumerate(['si', '1y', '5y', '10y', 'blended'], start=1):
            plt.subplot(5, 1, i)
            plt.title(f'{self.ticker} momentum sharpe ratio {period} heat map', fontsize=15)
            sharpe_matrix = self.pnls.pivot_table(index='slow_window', columns='fast_window', values=f'sharpe_{period}')
            if sharpe_matrix.empty or sharpe_matrix.isnull().all().all():
                continue
            sns.heatmap(sharpe_matrix, cmap='YlGnBu', annot=True, fmt='.0f')
        plt.tight_layout()
        if save:
            plt.savefig(self.dirpath + f'\\{self.ticker}_' + save_name + '.pdf', bbox_inches='tight')
        plt.show()
    
    def update_dfBestWindows(self, dfBestWindows, criteria:str, cluster=False, cluster_size=None):
        """
        Function to update the dfBestWindows DataFrame with the optimal fast and slow windows.
    
        Parameters:
        dfBestWindows (pd.DataFrame): The DataFrame to update.
        criteria (str): The string indicating whether to use 'rtn' or 'sharpe' for window selection.
        cluster (bool): Whether to use clustering or not.
        cluster_size (optional): Additional parameter used only when cluster=True.
    
        Returns:
        None
        """
        for period in ['si', '1y', '5y', '10y', 'blended']:
            if self.pnls[f'{criteria}_{period}'].empty or self.pnls[f'{criteria}_{period}'].isnull().all():
                continue
            if cluster:
                slow_fast = cluster_maxidx(self.pnls.pivot(index='slow_window', columns='fast_window', values=f'{criteria}_{period}'), window=cluster_size)
                idx = self.pnls[(self.pnls['fast_window'] == slow_fast[1]) & (self.pnls['slow_window'] == slow_fast[0])].index
                dfBestWindows.loc[self.ticker, f'fast_window_{period}'] = slow_fast[1]
                dfBestWindows.loc[self.ticker, f'slow_window_{period}'] = slow_fast[0]
                dfBestWindows.at[self.ticker, f'rtn_{period}'] = float(self.pnls.loc[idx, f'rtn_{period}'].iloc[0])
                dfBestWindows.at[self.ticker, f'sharpe_{period}'] = float(self.pnls.loc[idx, f'sharpe_{period}'].iloc[0])
            else:
                idx = self.pnls[f'{criteria}_{period}'].idxmax()
                dfBestWindows.at[self.ticker, f'fast_window_{period}'] = int(self.pnls.loc[idx, 'fast_window'])
                dfBestWindows.at[self.ticker, f'slow_window_{period}'] = int(self.pnls.loc[idx, 'slow_window'])
                dfBestWindows.at[self.ticker, f'rtn_{period}'] = self.pnls.loc[idx, f'rtn_{period}']
                dfBestWindows.at[self.ticker, f'sharpe_{period}'] = self.pnls.loc[idx, f'sharpe_{period}']



################################################# CV Window Selection #################################################
class CrossValidation:
    """
    A class to perform cross-validation on a given dataset.

    Attributes:
        CrossOverEngine (class): Pre-defined engine for cross over scenarios.
        test_weight (float): The weight given to the test results in the final evaluation.
        df (DataFrame): The dataset to be used for cross-validation.
        shares (int): The number of partitions to divide the dataset into.
        criteria (str): The criteria to be used for evaluation.
        cluster (bool): Whether to use clustering for evaluation.
        cluster_size (int): The size of the cluster to be used for evaluation.
        glue (bool): Whether to concatenate the training partitions.
        count (int): The number of samples in each partition.
    """
    def __init__(self, CrossOverEngine, test_weight, df, shares, criteria, cluster=False, cluster_size=None, glue=False):
        self.engine = CrossOverEngine
        self.test_weight = test_weight
        self.df = df
        self.shares = shares
        self.criteria = criteria
        self.cluster = cluster
        self.cluster_size = cluster_size
        self.glue=glue
        self.count = int(len(df)/shares)
    
    def partition_data(self):
        """
        Partitions the dataset into training and testing sets.

        Returns:
            stored_train (list): A list of training sets.
            stored_test (list): A list of testing sets.
        """
        stored_train = []
        stored_test = []
        for share in range(self.shares):
            train1 = self.df.iloc[:share*self.count]
            test = self.df.iloc[share*self.count:(share+1)*self.count]
            train2 = self.df.iloc[(share+1)*self.count:]
            if self.glue:
                train = pd.concat([train1, train2])
                stored_test.append(test)
                stored_train.append(train)
            else:
                stored_test.append(test)
                stored_train.append([train1, train2])
        return stored_train, stored_test

    def train_and_test_windows(self, ticker, currency, notional, contracts, dv01, cost, RelativePnL=False, decay=False, decayrate=None):
        """
        Trains and tests the model on the partitioned dataset.

        Parameters:
            ticker (str): The ticker symbol of the asset.
            currency (str): The security's local currency.
            notional (float): The notional value of the asset.
            contracts (int): The number of contracts.
            dv01 (float): The DV01 value of the asset.
            cost (float): The cost of the asset.
            RelativePnL (bool): Whether to use relative PnL for evaluation.

        Returns:
            train_results (list): A list of training results.
            test_results (list): A list of testing results.
        """
        train, test = self.partition_data()
        train_results = []
        test_results = []
        for train_list in train:
            if self.glue:
                trained = self.engine.futures_simplified(ticker, currency, notional, contracts, dv01, cost, train_list, RelativePnL, decay, decayrate)
                train_results.append(trained)
            else:
                trained1 = self.engine.futures_simplified(ticker, currency, notional, contracts, dv01, cost, train_list[0], RelativePnL, decay, decayrate) if not train_list[0].empty else None
                trained2 = self.engine.futures_simplified(ticker, currency, notional, contracts, dv01, cost, train_list[1], RelativePnL, decay, decayrate) if not train_list[1].empty else None
                if trained1 is not None and trained2 is not None:
                    average_train = (trained1+trained2)/2
                    train_results.append(average_train)
                elif trained1 is not None:
                    train_results.append(trained1)
                elif trained2 is not None:
                    train_results.append(trained2)
        for test_samp in test:
            tested = self.engine.futures_simplified(ticker, currency, notional, contracts, dv01, cost, test_samp, RelativePnL, decay, decayrate)
            test_results.append(tested)
        return train_results, test_results

    def best_windows(self, ticker, currency, notional, contracts, dv01, cost, RelativePnL=False, decay=False, decayrate=None):
        """
        Finds the best windows for the given criteria.

        Parameters:
            ticker (str): The ticker symbol of the asset.
            currency (str): The security's local currency.
            notional (float): The notional value of the asset.
            contracts (int): The number of contracts.
            dv01 (float): The DV01 value of the asset.
            cost (float): The cost of the asset.
            RelativePnL (bool): Whether to use relative PnL for evaluation.

        Returns:
            cv_windows (DataFrame): A DataFrame containing the best windows for each run.
            avg_list (list): A list of average results for each run.
        """
        train_results, test_results = self.train_and_test_windows(ticker, currency, notional, contracts, dv01, cost, RelativePnL, decay, decayrate)
        avg_list = []
        cv_windows = pd.DataFrame(index=['fast_window','slow_window',f'{self.criteria}'])
        for run in range(self.shares):
            avg = train_results[run]
            avg[['return','sharpe','mdd']] = train_results[run][['return','sharpe','mdd']]*(1-self.test_weight) + test_results[run][['return','sharpe','mdd']]*self.test_weight
            avg_list.append(avg)
            if self.cluster:
                slow_fast = cluster_maxidx(avg.pivot(index='slow_window', columns='fast_window', values=f'{self.criteria}'), window=self.cluster_size)
                idx = avg[(avg['fast_window'] == slow_fast[1]) & (avg['slow_window'] == slow_fast[0])].index
                cv_windows.loc['fast_window',f'cv_run_{run+1}'] = slow_fast[1]
                cv_windows.loc['slow_window',f'cv_run_{run+1}'] = slow_fast[0]
                cv_windows.loc[f'{self.criteria}',f'cv_run_{run+1}'] = avg.loc[idx,f'{self.criteria}'].iloc[0]
            else:
                idx = avg[f'{self.criteria}'].idxmax()
                cv_windows.loc['fast_window',f'cv_run_{run+1}'] = avg.loc[idx,'fast_window']
                cv_windows.loc['slow_window',f'cv_run_{run+1}'] = avg.loc[idx,'slow_window']
                cv_windows.loc[f'{self.criteria}',f'cv_run_{run+1}'] = avg.loc[idx,f'{self.criteria}']
        return cv_windows, avg_list

    def train_and_test_windows_LS(self, ticker, currency, direction, notional, contracts, dv01, cost, RelativePnL=False, decay=False, decayrate=None):
        """
        Perform training and testing of a long-short crossover strategy using partitioned data windows.
        This method applies the `cross_over_scenarios_simplified_LS` function to each training and testing window.
        If `self.glue` is True, training data is treated as a single combined DataFrame. Otherwise, it processes
        each sub-window separately and averages the results if both are available.
    
        Parameters:
        ticker: The asset ticker symbol.
        currency: The currency in which the asset is denominated.
        direction: Strategy direction, e.g., 'long', 'short', or 'both'.
        notional: Notional amount for the trade.
        contracts: Number of contracts.
        dv01: Dollar value of a 1 basis point move.
        cost: Transaction cost per trade.
        RelativePnL: If True, compute PnL relative to notional. Defaults to False.
    
        Returns:
        train_results: A list of DataFrames containing performance metrics for each training window.
        test_results: A list of DataFrames containing performance metrics for each testing window.
        """
        train, test = self.partition_data()
        train_results = []
        test_results = []
        for train_list in train:
            if self.glue:
                trained = self.engine.long_short_simplified(ticker, currency, direction, notional, contracts, dv01, cost, train_list, RelativePnL, decay, decayrate)
                train_results.append(trained)
            else:
                trained1 = self.engine.long_short_simplified(ticker, currency, direction, notional, contracts, dv01, cost, train_list[0], RelativePnL) if not train_list[0].empty else None
                trained2 = self.engine.long_short_simplified(ticker, currency, direction, notional, contracts, dv01, cost, train_list[1], RelativePnL) if not train_list[1].empty else None
                if trained1 is not None and trained2 is not None:
                    average_train = (trained1 + trained2) / 2
                    train_results.append(average_train)
                elif trained1 is not None:
                    train_results.append(trained1)
                elif trained2 is not None:
                    train_results.append(trained2)
        for test_samp in test:
            tested = self.engine.long_short_simplified(ticker, currency, direction, notional, contracts, dv01, cost, test_samp, RelativePnL, decay, decayrate)
            test_results.append(tested)
        return train_results, test_results

    def best_windows_LS(self, ticker, currency, direction, notional, contracts, dv01, cost, RelativePnL=False, decay=False, decayrate=None):
        """
        Identify the best-performing fast and slow moving average window combinations for a long-short crossover strategy
        using cross-validation across multiple training and testing splits.
        This method evaluates performance across multiple data partitions, optionally applies clustering to smooth
        the selection of optimal parameters, and returns the best window combinations for each cross-validation run.
    
        Parameters:
        ticker: The asset ticker symbol.
        currency: The currency in which the asset is denominated.
        direction: Strategy direction, e.g., 'long', 'short', or 'both'.
        notional: Notional amount for the trade.
        contracts: Number of contracts.
        dv01: Dollar value of a 1 basis point move.
        cost: Transaction cost per trade.
        RelativePnL: If True, compute PnL relative to notional. Defaults to False.
    
        Returns:
        cv_windows: A DataFrame summarizing the best fast and slow window combinations and their performance
                    metric for each cross-validation run.
        avg_list: A list of DataFrames containing the weighted average performance metrics for each run.
        """
        train_results, test_results = self.train_and_test_windows_LS(ticker, currency, direction, notional, contracts, dv01, cost, RelativePnL, decay, decayrate)
        avg_list = []
        cv_windows = pd.DataFrame(index=['fast_window','slow_window',f'{self.criteria}'])
        for run in range(self.shares):
            avg = train_results[run]
            avg[['return','sharpe','mdd']] = train_results[run][['return','sharpe','mdd']]*(1-self.test_weight) + test_results[run][['return','sharpe','mdd']]*self.test_weight
            avg_list.append(avg)
            if self.cluster:
                slow_fast = cluster_maxidx(avg.pivot(index='slow_window', columns='fast_window', values=f'{self.criteria}'), window=self.cluster_size)
                idx = avg[(avg['fast_window'] == slow_fast[1]) & (avg['slow_window'] == slow_fast[0])].index
                cv_windows.loc['fast_window',f'cv_run_{run+1}'] = slow_fast[1]
                cv_windows.loc['slow_window',f'cv_run_{run+1}'] = slow_fast[0]
                cv_windows.loc[f'{self.criteria}',f'cv_run_{run+1}'] = avg.loc[idx,f'{self.criteria}'].iloc[0]
            else:
                idx = avg[f'{self.criteria}'].idxmax()
                cv_windows.loc['fast_window',f'cv_run_{run+1}'] = avg.loc[idx,'fast_window']
                cv_windows.loc['slow_window',f'cv_run_{run+1}'] = avg.loc[idx,'slow_window']
                cv_windows.loc[f'{self.criteria}',f'cv_run_{run+1}'] = avg.loc[idx,f'{self.criteria}']
        return cv_windows, avg_list
