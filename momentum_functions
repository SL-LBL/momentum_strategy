            buffer_vals = [round(i, 10) for i in self._frange(self.buffer_start, self.max_buffer + 0.01, self.skip_buffer)]
            slope_combos = pd.DataFrame(
                [(sf, ss, b) for sf in slope_fast_vals for ss in slope_slow_vals for b in buffer_vals if sf < ss],
                columns=['fast_slope', 'slow_slope', 'buffer']
            )
            pnls = pnls.assign(key=1).merge(slope_combos.assign(key=1), on='key').drop('key', axis=1)
        def calc_metrics(row):
            return performance_metrics(
                cross_over_strategy_long_short(
