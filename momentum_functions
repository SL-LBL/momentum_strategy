class TransformTickerDescs:
    """
    A class to calculate position sizing (weights, contracts, notionals) for different types of fixed income securities
    based on a DV01 budget and investment amount.
    """
    def __init__(self, tickerDescs, budget, AmtInvested):
        """
        Initialize the TransformTickerDescs object.

        Parameters:
        ----------
        tickerDescs : list of tuples
            Description of each security. The structure depends on the type (futures, yields, or long-short pairs):

            Futures: (Ticker, Currency, Duration, Weight, MV/Contract, FXRate, ContractSizeLocal, fast_window, slow_window, fast_slope, slow_slope, slope_buffer)
            Long-Short Futures: (Ticker, Currency, Duration, Direction, Pair#, Weight, MV/Contract, FXRate, ContractSizeLocal)

        budget : float
            The total DV01 budget to allocate across all instruments (usually in CAD or USD).

        AmtInvested : float
            The target total notional exposure.
        """
        self.tickerDescs = tickerDescs
        self.budget = budget
        self.AmtInvested = AmtInvested

    def futures(self):
        """
        Compute notional, weights, and number of contracts for each **futures contract** 
        based on DV01 budget and instrument characteristics.

        Returns:
        -------
        list of tuples:
            Each tuple represents a futures instrument:
            (Ticker, Currency, Notional (CAD), Weight, #Contracts, DV01 (CAD), FXRate, ContractSize (Local), fast_window, slow_window)
        """
        dv01s = [x[6]*x[5]*x[2]/10000 for x in self.tickerDescs]
        budgetShare = self.budget/len(self.tickerDescs)
        contracts = [round(budgetShare/dv01s[idx]) for idx, x in enumerate(self.tickerDescs)]
        notionals = [contracts[idx]*x[5]*x[6] for idx, x in enumerate(self.tickerDescs)]
        totalNotional = sum(notionals)
        tickerDescs = [x[:2]+(contracts[idx]*x[6]*x[5], notionals[idx]/totalNotional, contracts[idx], dv01s[idx])+x[5:] for idx, x in enumerate(self.tickerDescs)]  
        return tickerDescs

    def long_short(self):
        """
        Compute notional, weights, and number of contracts for **long-short futures pairs** 
        based on the DV01 budget. Each pair receives equal DV01 budget.

        Returns:
        -------
        list of tuples:
            Each tuple represents a leg of a long-short pair:
            (Ticker, Currency, Direction, Pair#, Notional, Weight, #Contracts, DV01 (CAD), FXRate, ContractSize (Local), fast_window, slow_window)
        """
        dv01s = [x[7]*x[8]*x[4]/10000 for x in self.tickerDescs]
        budgetShare = self.budget/len(set([x[3] for x in self.tickerDescs])) # Each each pair equally splits the total dv01 budget
        contracts = [x[2]*round(budgetShare/dv01s[idx]) for idx, x in enumerate(self.tickerDescs)]
        notionals = [contracts[idx]*x[7]*x[8] for idx, x in enumerate(self.tickerDescs)]
        grossNotional = sum(abs(notional) for notional in notionals)
        tickerDescs = [x[:4] + (notionals[idx], notionals[idx]/grossNotional, contracts[idx], dv01s[idx]) + x[8:] for idx, x in enumerate(self.tickerDescs)]            
        return tickerDescs

    def tickers(self):
        """
        Extract and return the list of tickers from the ticker descriptions.

        Returns:
        -------
        list of str:
            Ticker names (e.g., "TY", "RX", etc.)
        """
        return [x[0] for x in self.tickerDescs]

    def unpack_long_short(self):
        """
        Transform long-short futures output into a dictionary grouped by pair number.

        Returns:
        -------
        dict:
            A dictionary with one entry per pair, each containing:
            {
                pair_number: {
                    'tickers': [list of ticker symbols],
                    'currencies': [list of currencies],
                    'directions': [1/-1],
                    'notionals': [CAD notional],
                    'weights': [portfolio weights],
                    'contracts': [number of contracts],
                    'dv01s': [DV01 (CAD)],
                    'contract_sizes': [local contract sizes]
                }
            }
        """
        LongShortDescs = self.long_short()
        LongShortDict = {}
        for pair_num in set(x[3] for x in LongShortDescs):
            LongShortDict[pair_num] = {}
            LongShortDict[pair_num]['tickers'] = [x[0] for x in LongShortDescs if x[3] == pair_num]
            LongShortDict[pair_num]['currencies'] = [x[1] for x in LongShortDescs if x[3] == pair_num]
            LongShortDict[pair_num]['directions'] = [x[2] for x in LongShortDescs if x[3] == pair_num]
            LongShortDict[pair_num]['notionals'] = [x[4] for x in LongShortDescs if x[3] == pair_num]
            LongShortDict[pair_num]['weights'] = [x[5] for x in LongShortDescs if x[3] == pair_num]
            LongShortDict[pair_num]['contracts'] = [x[6] for x in LongShortDescs if x[3] == pair_num]
            LongShortDict[pair_num]['dv01s'] = [x[7] for x in LongShortDescs if x[3] == pair_num]
            LongShortDict[pair_num]['contract_sizes'] = [x[8] for x in LongShortDescs if x[3] == pair_num]
        return LongShortDict
    
