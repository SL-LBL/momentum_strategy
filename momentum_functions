    if not pd.isnull(startDate_5y):
        rtn_5y = rtn_si - data.loc[startDate_5y,colCumRtn]
        sharpe_5y = annual_coef * (data[data.index>startDate_5y][colDlyRtn].mean()-daily_risk_free_rate) / data[data.index>startDate_5y][colDlyRtn].std()
    else:
        rtn_5y = 0
        sharpe_5y = 0
    mdd_5y = calc_mdd(data[data.index>startDate_5y])

    # 10-year return
    startDate_10y = maxDate.replace(year = maxDate.year-10)
    startDate_10y = data[data.index<startDate_10y].index.max()
    if not pd.isnull(startDate_10y):
        rtn_10y = rtn_si - data.loc[startDate_10y,colCumRtn]
        sharpe_10y = annual_coef * (data[data.index>startDate_10y][colDlyRtn].mean()-daily_risk_free_rate) / data[data.index>startDate_10y][colDlyRtn].std()
    else:
        rtn_10y = np.NaN
        sharpe_10y = np.NaN
    mdd_10y = calc_mdd(data[data.index>startDate_5y])
    
    rtn_blended = np.nanmean((rtn_si, rtn_1y, rtn_5y, rtn_10y))
