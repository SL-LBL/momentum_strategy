################################################# Window Scenarios #################################################
class CrossOverScenarios:
    """
    Set up maximum windows for fast and slow window selection. Also set up steps in loops.
    """
    def __init__(self, fast_start=5, slow_start=20, max_fast=50, max_slow=200, skip=1, 
                 momentum_2nd=False, ignore_1st_order=False, dynamic_alloc=False,
                 slowslope_start=None, fastslope_start=None, max_slopefast=None, max_slopeslow=None,
                 skip_slope=None, buffer_start=0.0, max_buffer=0.0, skip_buffer=None,
                 deviation=False, r2=False, dev_r2=False):
        self.fast_start = fast_start
        self.slow_start = slow_start
        self.skip = skip
        self.max_fast = max_fast
        self.max_slow = max_slow
        self.momentum_2nd = momentum_2nd
        self.ignore_1st_order = ignore_1st_order
        self.dynamic_alloc = dynamic_alloc
        self.slowslope_start = slowslope_start
        self.fastslope_start = fastslope_start
        self.skip_slope = skip_slope
        self.max_slopefast = max_slopefast
        self.max_slopeslow = max_slopeslow
        self.skip_buffer = skip_buffer
        self.buffer_start = buffer_start
        self.max_buffer = max_buffer
        self.deviation = deviation
        self.r2 = r2
        self.dev_r2 = dev_r2

    def _frange(self, start, stop, step):
        if step == 0:
            if start == stop:
                yield round(start, 10)
            else:
                raise ValueError("Step size cannot be zero unless start == stop")
        elif start == stop:
            yield round(start, 10)
        else:
            while start < stop:
                yield round(start, 10)
                start += step

    def futures_simplified(self, ticker, currency, notional, contracts, dv01, cost, df,
                        RelativePnL=False, decay=False, decayrate=None):
        if len(df) <= self.fast_start:
            return None
        pnls = pd.DataFrame(range(self.slow_start, self.max_slow + 1, self.skip), columns=['slow_window'])
        pnls['fast_window'] = pnls['slow_window'].apply(
            lambda val: range(self.fast_start, min(val // 2, self.max_fast) + 1, self.skip)
        )
        pnls = pnls.explode('fast_window', ignore_index=True)
        if self.momentum_2nd or self.ignore_1st_order:
            slope_fast_vals = list(range(self.fastslope_start, self.max_slopefast + 1, self.skip_slope))
            slope_slow_vals = list(range(self.slowslope_start, self.max_slopeslow + 1, self.skip_slope))
            buffer_vals = [round(i, 10) for i in self._frange(self.buffer_start, self.max_buffer + 0.01, self.skip_buffer)]
            slope_combos = pd.DataFrame(
                [(sf, ss, b) for sf in slope_fast_vals for ss in slope_slow_vals for b in buffer_vals if sf < ss],
                columns=['fast_slope', 'slow_slope', 'buffer']
            )
            if self.ignore_1st_order:
                slope_combos = slope_combos.drop_duplicates(subset=['fast_slope', 'slow_slope'])
            pnls = pnls.assign(key=1).merge(slope_combos.assign(key=1), on='key').drop('key', axis=1)
        def calc_metrics(row):
            return performance_metrics(
                cross_over_strategy(
                    ticker=ticker,
                    curr=currency,
                    notional=notional,
                    contracts=contracts,
                    dv01=dv01,
                    cost=cost,
                    fast_window=row['fast_window'],
                    slow_window=row['slow_window'],
                    df=df,
                    RelativePnL=RelativePnL,
                    decay=decay,
                    decayrate=decayrate,
                    momentum_2nd=self.momentum_2nd,
                    dynamic_alloc=self.dynamic_alloc,
                    ignore_1st_order=self.ignore_1st_order,
                    fast_slope=row.get('fast_slope'),
                    slow_slope=row.get('slow_slope'),
                    buffer_2nd=row.get('buffer')
                ),
                deviation=self.deviation,
                r2=self.r2,
                dev_r2=self.dev_r2
            )
        pnls[[
            'cumulative return', 'return', 'sharpe', 'deviation from 50', 'mdd', 'R2 positive rtn',
            'sharpe_dev', 'sharpe_r2', 'sharpe_dev_r2'
        ]] = pnls.apply(calc_metrics, axis=1, result_type='expand')
        return pnls

