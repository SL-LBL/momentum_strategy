def cross_over_strategy(ticker, curr, notional, contracts, dv01, cost, fast_window, slow_window, df, RelativePnL=False):
    """
    Implement a crossover strategy and calculate trading metrics.

    Parameters:
    ticker (str): The ticker symbol
    curr (str): The contract's local currency
    notional (float): The notional value of the investment
    contracts (int): the number of contracts needed
    dv01 (float): dv01 of each contract
    cost (float): The cost of trading
    fast_window (int): The window size for fast moving average
    slow_window (int): The window size for slow moving average
    df (DataFrame): The data frame with the price data
    RelativePnL (bool): If True, rescale PnL to percentage format

    Returns:
    DataFrame: The data frame with calculated metrics
    """
    assert fast_window < slow_window
    if ticker.endswith(" Curncy"): # different calculation for UK because using swaps
        data = df[['Date', f'{ticker}_mid'] + ([curr] if curr != 'CAD' else [])].set_index('Date').sort_index(ascending=True).dropna()
        data.columns = [ticker] + ([curr] if curr != 'CAD' else [])
    else:
        data = df[['Date', f'{ticker}_mid', f'{ticker}_Dur'] + ([curr] if curr != 'CAD' else [])].set_index('Date').sort_index(ascending=True).dropna()
        data.columns = [ticker, 'duration'] + ([curr] if curr != 'CAD' else [])

    data['FMA'] = data[ticker].rolling(window=fast_window).mean()
    data['SMA'] = data[ticker].rolling(window=slow_window).mean()
    data['Signal'] = (data['FMA'] > data['SMA']).astype(int) - (data['FMA'] < data['SMA']).astype(int)

    if ticker.endswith(" Curncy"): # different calculation for UK because using swaps
        data['Signal'] = data['Signal'] * -1 # reverse signal because data is expressed in swap spreads instead of prices
        # Generate trading costs (assumed spread(bps) * #contracts * dv01 * 2)
        data['TradeCost'] = abs(data['Signal'].diff()).shift(1)*cost*contracts*dv01
        # Generate pre-cost PnL (change in spread * 100 * signal * contracts * dv01)
        data['ReturnNoCost'] =  -data[ticker].diff()*100*data['Signal'].shift(1)*contracts*dv01    
    else:
        # Generate trading costs (assumed spread(bps) * #contracts * cost * notional * duration / 10000 * 2)
        data['TradeCost'] = abs(data['Signal'].diff()).shift(1)*cost*notional*data['duration']/10000
        # Generate pre-cost PnL (change in price / 100 * signal * notional)
        data['ReturnNoCost'] =  data[ticker].diff()/100*data['Signal'].shift(1)*notional
    
    data['DailyReturn'] = data['ReturnNoCost'] - data['TradeCost'] # Generate post-cost PnL (pre-cost - cost)
    if curr != 'CAD':
        data['DailyReturn'] = data['DailyReturn' ] * (data[curr].pct_change(fill_method=None) + 1)
    data['CumulativeReturn'] = data['DailyReturn'].cumsum() # Generate cumulative post-cost PnL

    if RelativePnL: #Rescale so that PnL is in % format
        data[['TradeCost','ReturnNoCost','DailyReturn','CumulativeReturn']] = data[['TradeCost','ReturnNoCost','DailyReturn','CumulativeReturn']]/notional
    
    return data


def cross_over_strategy_long_short(ticker, currency, direction, notional, contracts, dv01, cost, fast_window, slow_window, df, RelativePnL=False):
    """
    Implements a long-short crossover trading strategy using two instruments and calculates associated PnL metrics.

    Parameters:
    ticker (list of str): List of two ticker symbols to be used in the strategy.
    currency (list of str): List of the two side's local currencies.
    direction (list of int): List of two integers (1 or -1) indicating long (1) or short (-1) position for each ticker.
    notional (list of float): List of notional values for each ticker.
    contracts (list of int): the number of contracts needed
    dv01 (list of float): dv01 of each contract
    cost (float): Trading cost in bps.
    fast_window (int): Window size for the fast moving average.
    slow_window (int): Window size for the slow moving average.
    df (DataFrame): Input DataFrame containing 'Date', mid prices, and durations for each ticker.
    RelativePnL (bool, optional): If True, scales PnL metrics by total notional to express them in relative terms. Default is False.

    Returns:
    DataFrame: A DataFrame indexed by date with calculated signals, trade costs, pre- and post-cost returns, and cumulative returns.
    """
    assert fast_window < slow_window
    tick = [tic+'_mid' for tic in ticker]
    dur = [tic+'_Dur' for tic in ticker if not tic.endswith(' Curncy')]
    curr = list(set([cur for cur in currency if cur != 'CAD']))

    data = df[['Date']+tick+dur+curr].set_index('Date').sort_index(ascending=True).dropna()
    data.columns = ticker + dur + curr
    long_short_name = '_'.join([f"{tick}{'long' if dirc==1 else 'short'}" for tick, dirc in zip(ticker, direction)])
    data.update({tick: 100 - data[tick] for tick in ticker if tick.endswith(' Curncy')}) # invert UK SONIA swap to generate signals.
    data[long_short_name] = data[ticker[0]]*direction[0] + data[ticker[1]]*direction[1]

    # Calculate the moving averages & generate signal
    data['FMA'] = data[long_short_name].rolling(window=fast_window).mean()
    data['SMA'] = data[long_short_name].rolling(window=slow_window).mean()
    data['Signal'] = (data['FMA'] > data['SMA']).astype(int) - (data['FMA'] < data['SMA']).astype(int)

    # Calculate trade cost and pnl for each leg
    for idx, tick in enumerate(ticker):
        if tick.endswith(' Curncy'):
            data[f'{tick}_TradeCost'] = abs(data['Signal'].diff()).shift(1)*cost*abs(contracts[idx])*dv01[idx]
            data[f'{tick}_ReturnNoCost'] = data[tick].diff()*100*data['Signal'].shift(1)*contracts[idx]*dv01[idx]
            if currency[idx] != 'CAD':
                data[f'{tick}_TradeCost'] = data[f'{tick}_TradeCost'] * (data[currency[idx]].pct_change(fill_method=None) + 1)
                data[f'{tick}_ReturnNoCost'] = data[f'{tick}_ReturnNoCost'] * (data[currency[idx]].pct_change(fill_method=None) + 1)
        else:
            data[f'{tick}_TradeCost'] = abs(data['Signal'].diff()).shift(1)*cost*abs(notional[idx])*data[f'{tick}_Dur']/10000
            data[f'{tick}_ReturnNoCost'] = data[tick].diff()/100*data['Signal'].shift(1)*notional[idx]
            if currency[idx] != 'CAD':
                data[f'{tick}_TradeCost'] = data[f'{tick}_TradeCost'] * (data[currency[idx]].pct_change(fill_method=None) + 1)
                data[f'{tick}_ReturnNoCost'] = data[f'{tick}_ReturnNoCost'] * (data[currency[idx]].pct_change(fill_method=None) + 1)
                
    data['ReturnNoCost'] = data[[f'{tick}_ReturnNoCost'for tick in ticker]].sum(axis=1)
    data['TradeCost'] = data[[f'{tick}_TradeCost' for tick in ticker]].sum(axis=1)
    data['DailyReturn'] = data['ReturnNoCost'] - data['TradeCost'] # Generate post-cost PnL (pre-cost - cost)
    data['CumulativeReturn'] = data['DailyReturn'].cumsum() # Generate cumulative post-cost PnL
    
    if RelativePnL: #Rescale so that PnL is in % format
        data[['TradeCost','ReturnNoCost','DailyReturn','CumulativeReturn']] = data[['TradeCost','ReturnNoCost','DailyReturn','CumulativeReturn']]/sum([abs(x) for x in notional])
    
    return data
    

def calc_analytics(data):
