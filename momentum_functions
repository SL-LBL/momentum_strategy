    return pd.Series([rtn_si, sharpe_si, mdd_si, startDate_1y, rtn_1y, sharpe_1y, mdd_1y, startDate_5y, rtn_5y, sharpe_5y, mdd_5y, startDate_10y, rtn_10y, sharpe_10y, mdd_10y, rtn_blended, sharpe_blended],
                     index=['rtn_si','sharpe_si','mdd_si','startDate_1y','rtn_1y','sharpe_1y','mdd_1y','startDate_5y','rtn_5y','sharpe_5y','mdd_5y','startDate_10y','rtn_10y','sharpe_10y','mdd_10y','rtn_blended','sharpe_blended'])


def performance_metrics(data):
    """
    Computes performance metrics from a DataFrame of strategy results.

    Parameters:
    data (pd.DataFrame): DataFrame containing 'DailyReturn' and 'CumulativeReturn' columns.

    Returns:
    pd.Series: A Series with total return, Sharpe ratio, and maximum drawdown.
    """
    maxDate = data.index.max()
    rtn = data.loc[maxDate, 'CumulativeReturn']
    annual_coef = math.sqrt(252)
    mean_rtn = data['DailyReturn'].mean()
    std_rtn = data['DailyReturn'].std()
    if std_rtn == 0 or np.isnan(std_rtn):
        sharpe = 0
    else:
        sharpe = annual_coef * mean_rtn / std_rtn
    mdd = calc_mdd(data)
    return pd.Series([mean_rtn, sharpe, mdd], index=['return', 'sharpe', 'mdd'])
    


################################################# Window Scenarios #################################################

class CrossOverScenarios:
    """
    Set up maximum windows for fast and slow window selection. Also set up steps in loops.
        
    Parameters:
    max_fast (int): The maximum fast-window to compute results.
    max_slow (int): The maximum slow-window to compute results.
    skip (int): How far apart windows are in each iteration (=1 will loop thorugh each window).
    """
    def __init__(self, max_fast, max_slow, skip):
        self.skip = skip
        self.max_fast = max_fast
        self.max_slow = max_slow
    
    def futures_full(self, ticker, currency, notional, contracts, dv01, cost, df, RelativePnL=False):
        """
        Implement a crossover strategy with various window sizes and calculate trading metrics to find the best windows.
    
        Parameters:
        ticker (str): The ticker symbol
        currency (str): The security's local currency
        notional (float): The notional value of the investment
        cost (float): The cost of trading
        contracts (int): the number of contracts needed
        dv01 (float): dv01 of each contract
        df (DataFrame): The data frame with the price data
    
        Returns:
        DataFrame: The data frame with calculated metrics for each window size
        """
        pnls = pd.DataFrame(range(20,self.max_slow+1,self.skip), columns=['slow_window'])
        pnls['fast_window'] = pnls['slow_window'].apply(lambda val: range(5,min(val//2,self.max_fast)+1,self.skip))
        pnls = pnls.explode('fast_window', ignore_index=True)
        pnls[['rtn_si','sharpe_si','mdd_si','startDate_1y','rtn_1y','sharpe_1y','mdd_1y','startDate_5y','rtn_5y','sharpe_5y','mdd_5y','startDate_10y','rtn_10y','sharpe_10y','mdd_10y','rtn_blended','sharpe_blended']] = pnls[['fast_window','slow_window']].apply(lambda x: calc_analytics(cross_over_strategy(ticker, currency, notional, contracts, dv01, cost, x.iloc[0], x.iloc[1], df, RelativePnL)), axis=1, result_type='expand')
        return pnls
    
    def long_short_full(self, ticker, currency, direction, notional, contracts, dv01, cost, df, RelativePnL=False):
        """
        Implement a crossover strategy with various window sizes and calculate trading metrics to find the best windows.
    
        Parameters:
        ticker (list of str): List of two ticker symbols to be used in the strategy.
        currency (list of str): The two securities' local currencies.
        direction (list of int): List of two integers (1 or -1) indicating long (1) or short (-1) position for each ticker.
        notional (list of float): List of notional values for each ticker.
        cost (float): Trading cost in bps.
        df (DataFrame): Input DataFrame containing 'Date', mid prices, and durations for each ticker.
        RelativePnL (bool, optional): If True, scales PnL metrics by total notional to express them in relative terms. Default is False.
    
        Returns:
        DataFrame: The data frame with calculated metrics for each window size
        """
        pnls = pd.DataFrame(range(20,self.max_slow+1,self.skip), columns=['slow_window'])
        pnls['fast_window'] = pnls['slow_window'].apply(lambda val: range(5,min(val//2,self.max_fast)+1,self.skip))
        pnls = pnls.explode('fast_window', ignore_index=True)
        pnls[['rtn_si','sharpe_si','mdd_si','startDate_1y','rtn_1y','sharpe_1y','mdd_1y','startDate_5y','rtn_5y','sharpe_5y','mdd_5y','startDate_10y','rtn_10y','sharpe_10y','mdd_10y','rtn_blended','sharpe_blended']] = pnls[['fast_window','slow_window']].apply(lambda x: calc_analytics(cross_over_strategy_long_short(ticker, currency, direction, notional, contracts, dv01, cost, x.iloc[0], x.iloc[1], df, RelativePnL)), axis=1, result_type='expand')
        return pnls
      
    def futures_simplified(self, ticker, currency, notional, contracts, dv01, cost, df, RelativePnL=False):
        """
        Runs a grid of crossover strategy scenarios for a given ticker and evaluates performance metrics.
    
        Parameters:
        ticker (str): The asset ticker.
        currency (str): The security's local currency
        notional (float): Notional value for the trade.
        contracts (int): Number of contracts.
        dv01 (float): Dollar value of a 1 basis point move.
        cost (float): Transaction cost.
        df (pd.DataFrame): Historical data for the asset.
        RelativePnL (bool): If True, returns are scaled relative to notional.
    
        Returns:
        pd.DataFrame: A DataFrame containing fast/slow window combinations and their corresponding
                      return, Sharpe ratio, and maximum drawdown.
        """
        pnls = pd.DataFrame(range(20,self.max_slow+1,self.skip), columns=['slow_window'])
        pnls['fast_window'] = pnls['slow_window'].apply(lambda val: range(5,min(val//2,self.max_fast)+1,self.skip))
        pnls = pnls.explode('fast_window', ignore_index=True)
        pnls[['return', 'sharpe', 'mdd']] = pnls[['fast_window', 'slow_window']].apply(
            lambda x: performance_metrics(
                cross_over_strategy(ticker, currency, notional, contracts, dv01, cost, x['fast_window'], x['slow_window'], df, RelativePnL)
            ),
            axis=1,
            result_type='expand'
        )
        return pnls
    
    def long_short_simplified(self, ticker, currency, direction, notional, contracts, dv01, cost, df, RelativePnL=False):
        """
        Run a grid search over combinations of fast and slow moving average windows for a long-short crossover strategy,
        and evaluate performance metrics for each combination.
    
        Parameters:
        ticker (str): The asset ticker symbol.
        currency (str): The currency in which the asset is denominated.
        direction (str): Strategy direction, e.g., 'long', 'short', or 'both'.
        notional (float): Notional amount for the trade.
        contracts (int): Number of contracts.
        dv01 (float): Dollar value of a 1 basis point move.
        cost (float): Transaction cost per trade.
        df (pd.DataFrame): Historical price data.
        RelativePnL (bool, optional): If True, compute PnL relative to notional. Defaults to False.
    
        Returns:
        pd.DataFrame: A DataFrame containing combinations of fast and slow windows along with their
          corresponding return, Sharpe ratio, and maximum drawdown (mdd).
        """
        pnls = pd.DataFrame(range(20,self.max_slow+1,self.skip), columns=['slow_window'])
        pnls['fast_window'] = pnls['slow_window'].apply(lambda val: range(5,min(val//2,self.max_fast)+1,self.skip))
        pnls = pnls.explode('fast_window', ignore_index=True)
        pnls[['return', 'sharpe', 'mdd']] = pnls[['fast_window', 'slow_window']].apply(
            lambda x: performance_metrics(
                cross_over_strategy_long_short(ticker, currency, direction, notional, contracts, dv01, cost, x['fast_window'], x['slow_window'], df, RelativePnL)
            ),
            axis=1,
            result_type='expand'
        )
        return pnls
