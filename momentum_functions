    Parameters:
    data (DataFrame): The data frame with the price data

    Returns:
    Series: A series with calculated returns and Sharpe ratios
    """
    colCumRtn = 'CumulativeReturn'
    colDlyRtn = 'DailyReturn'
    
    maxDate = data.index.max()
    minDate = data.index.min()
    rtn_si = data.loc[maxDate,colCumRtn]
    annual_coef = math.sqrt(252) # assuming 252 days a year
    daily_risk_free_rate = 0 #480/365  # assuming risk-free rate of 4.8
    sharpe_si = annual_coef * (data[colDlyRtn].mean()-daily_risk_free_rate) / data[colDlyRtn].std()
    mdd_si = calc_mdd(data)
    
    # 1-year return
    startDate_1y = maxDate.replace(year = maxDate.year-1)
    startDate_1y = data[data.index<startDate_1y].index.max()
    if not pd.isnull(startDate_1y):
        rtn_1y = rtn_si - data.loc[startDate_1y,colCumRtn]
        sharpe_1y = annual_coef * (data[data.index>startDate_1y][colDlyRtn].mean()-daily_risk_free_rate) / data[data.index>startDate_1y][colDlyRtn].std()
    else:
        rtn_1y = 0
        sharpe_1y = 0
    mdd_1y = calc_mdd(data[data.index>startDate_1y])
    
    # 5-year return
    startDate_5y = maxDate.replace(year = maxDate.year-5)
