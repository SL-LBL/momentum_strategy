import pandas as pd
import numpy as np
import statsmodels.formula.api as smf


def create_lag(df, series_name: str, lag: int):
    df.sort_index(ascending=True, inplace=True)
    df[f'{series_name}_lag_{lag}'] = df[series_name].shift(lag)
    return df

def ols_reg(data, y_col: str, x_col: list, intercept):
    if intercept:
        model = smf.ols('{y} ~ {x}'.format(y=y_col, x=" + ".join(x_col)), data).fit()
    else:
        model = smf.ols('{y} ~ {x} - 1'.format(y=y_col, x=" + ".join(x_col)), data).fit()
    return model

def create_forecasts_lags(df, y_col: str, lags: int, forecasts: int, differenced):
    temp = pd.DataFrame(df[y_col])
    temp.sort_index(ascending=True, inplace=True)
    if differenced:
        temp[f'{y_col}_{forecasts}_periods_forward'] = temp[y_col].rolling(window=forecasts).sum().shift(-forecasts)
        temp[f'{y_col}_{lags}_periods_lag'] = temp[y_col].rolling(window=lags).sum()
    else:
        temp = temp.diff()
        temp[f'{y_col}_{forecasts}_periods_forward'] = temp[y_col].rolling(window=forecasts).sum().shift(-forecasts)
        temp[f'{y_col}_{lags}_periods_lag'] = temp[y_col].rolling(window=lags).sum()
    return temp
