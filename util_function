def store_json(dict, name='save.json'):
    """
    Stores a dictionary of pandas DataFrames as a JSON file.

    Each DataFrame is converted to a nested dictionary using `to_dict()`, which is JSON serializable.
    
    Args:
        dict (dict): Dictionary where keys are strings and values are pandas DataFrames.
        name (str): Name of the output JSON file. Defaults to 'save.json'.
    """
    import json
    serializable_pnls = {k: v.to_dict() for k, v in dict.items()}
    with open(name, 'w') as f:
        json.dump(serializable_pnls, f, indent=4)


def load_json(name):
    """
    Loads a JSON file into a dictionary of pandas DataFrames.

    Assumes the JSON was created using `store_json` where each value is a nested dictionary 
    compatible with `pd.DataFrame`.

    Args:
        name (str): Path to the JSON file.

    Returns:
        dict: Dictionary where keys are strings and values are pandas DataFrames.
    """
    import json
    with open(name, "r") as f:
        json_dict = json.load(f)
    df_dict = {k: pd.DataFrame(v) for k, v in json_dict.items()}
    return df_dict


def decay_moving_avg(series, window, decayrate):
    """
    Calculate a decayed moving average of a time series using exponential decay.

    Parameters:
    series (pd.Series): The input time series data.
    window (int): The number of past observations to consider in the moving average.
    decayrate (float): The decay rate per time step (0 means no decay; higher values apply faster decay).

    Returns:
    pd.Series: A series containing the decayed moving average values.

    Notes:
    - More recent observations are weighted more heavily according to the formula:
        weight_i = (1 - decayrate) ** i, where i = 0 is the most recent.
    - If decayrate is 0.0, this function defaults to a simple moving average.
    - For early time points with fewer than `window` observations, weights are truncated accordingly.
    """
    if decayrate == 0.0:
        return series.rolling(window=window).mean()
    weights = np.array([(1-decayrate)**i for i in range(window)])
    weights = weights[::-1]

    def weighted_avg(x):
        if len(x) < window:
            w = weights[-len(x):]
            return np.dot(x, w) / w.sum()
        else:
            return np.dot(x,weights) / weights.sum()
    
    return series.rolling(window=window).apply(weighted_avg, raw=True)


def cluster_maxidx(df, window):
    """
    Ensure the window size is odd, perform clustering, and return the index and column names of the highest number in the cluster.
    
    Parameters:
    df (pd.DataFrame): The input dataframe.
    window (int): The window size (N), representing an NxN box around the centroid.
    
    Returns:
    tuple: The index (slow_window) and column (fast_window) names of the highest number in the cluster.
    """
    if window % 2 == 0: # force window to be odd so each cluster centers on the representative window
        window += 1
    fill = df.mean().mean() # fill NaN and extend df border with the mean value
    clustered = pd.DataFrame(uniform_filter(df.fillna(fill), size=window, mode='constant', cval=fill), index=df.index, columns=df.columns)
    max_index = clustered.stack().idxmax()
    return max_index # max_index: slow_window, max_index: fast_window


def plot_series(df, title='', fname='Save', save=False):
    """
    Plots a time series from a DataFrame.

    Parameters:
    df (pd.DataFrame): The DataFrame containing the time series data.
    title (str): The title of the plot.
    fname (str): The filename to save the figure as.
    save (bool): Whether to save the figure or not.

    Returns:
    None
    """
    plt.figure(figsize=(9, 6))
    for col in df:
        plt.plot(df[col], label=col)
    plt.grid(True)
    plt.legend()
    plt.title(title)
    plt.xlabel('Date')
    plt.ylabel('Value')
    if save:
        plt.savefig(fname)
    plt.show()


def plot_heatmap(df, annot=False, title='', fname='Heatmap', save=False):
    """
    Plot a heatmap from a DataFrame using seaborn.

    Parameters:
    df (DataFrame): The data to visualize as a heatmap.
    annot (bool): If True, display the numeric value in each cell.
    title (str): Title of the heatmap (currently unused).
    fname (str): File name to save the heatmap image if save=True.
    save (bool): If True, saves the heatmap to the specified file name.

    Returns:
    None
    """
    plt.figure(figsize=(20,10))
    sns.heatmap(df, cmap='YlGnBu', annot=annot, fmt='.0f')
    plt.tight_layout()
    if save:
        plt.savefig(fname)
    plt.show()


def plot_3d_surface(df, title='', xlabel='', ylabel='', zlabel='', fname='3d surface', save=False):
    """
    Plots a 3D surface from a DataFrame where index and columns represent the X and Y axes,
    and the values represent the Z axis.

    Parameters:
        df (pd.DataFrame): A DataFrame with numeric index and columns. 
                           The index represents Y values, columns represent X values.
        title (str): Title of the plot.
        xlabel (str): Label for the X-axis.
        ylabel (str): Label for the Y-axis.
        zlabel (str): Label for the Z-axis.
        fname (str): Filename to save the plot (only used if save=True).
        save (bool): If True, saves the plot to a file using `fname`.

    Returns:
        None
    """
    X_vals = np.array(df.index, dtype=float)
    Y_vals = np.array(df.columns, dtype=float)
    X, Y = np.meshgrid(Y_vals, X_vals)
    Z = df.values.astype(float)
    fig = plt.figure(figsize=(12, 8))
    ax = fig.add_subplot(111, projection='3d')
    surf = ax.plot_surface(X, Y, Z, cmap='YlGnBu', edgecolor='k')
    ax.set_xlabel(xlabel)
    ax.set_ylabel(ylabel)
    ax.set_zlabel(zlabel)
    ax.set_title(title)
    fig.colorbar(surf, ax=ax, shrink=0.5, aspect=10)
    plt.tight_layout()
    if save:
        plt.savefig(fname)
    plt.show()


def get_cum_rtns(returns, additive=True):
    """
    Calculate cumulative returns.

    Parameters:
    returns (pd.DataFrame): DataFrame of returns in decimals. The index must be datetime.
    additive (bool): If True, use additive returns. Otherwise, use multiplicative returns.

    Returns:
    pd.DataFrame: DataFrame of cumulative returns.
    """
    returns.index = pd.to_datetime(returns.index)
    if additive:   
        return returns.cumsum()
    else:
        return (1 + returns).cumprod() - 1


def plot_cum_rtns(df, title='', fname='Save', additive=True, save=False, dotted_series=None, bold_series=None):
    """
    Plots multiple cumulative returns. 
    
    Parameters:
    df (pd.DataFrame): DataFrame of returns in decimals. The index must be datetime.
    title (str): Title of the plot.
    fname (str): Name to save the file as.
    additive (bool): If True, use additive returns. Otherwise, use multiplicative returns.
    save (bool): If true, saves the file.
    dotted_series (str): Name of the series to be plotted with a dotted line.
    bold_series (str): Name of the series to be plotted with bold line.

    Returns:
    None
    """
    cum_ret = get_cum_rtns(df, additive)
    plt.figure(figsize=(9, 6))
    for series in cum_ret:
        linestyle = 'dotted' if series == dotted_series else 'solid'
        linewidth = 2.5 if series == bold_series else 1.2
        plt.plot(cum_ret[series], label=series, linestyle=linestyle, linewidth=linewidth)
    plt.grid(True)
    plt.legend()
    plt.title(title)
    plt.xlabel('Date')
    plt.ylabel('Return')
    if save:
        plt.savefig(fname)
    plt.show()


def calc_avg_hold(data):
    tot_days = len(data)
    switches = data['Signal'].diff().abs().sum()/2
    return tot_days/switches


def millions(x, pos):
    'The two args are the value and tick position'
    return '%1.0fM' % (x*1e-6)


def calc_mdd(df, col='DailyReturn', compound=False):
    if compound:
        cumulative = (1 + df[col]).cumprod()
        peak = cumulative.cummax()
        return -(cumulative/peak - 1).min()
    else:
        cumulative = df[col].cumsum()
        peak = cumulative.cummax()
        return -(cumulative - peak).min()


def divide_chunks(lst, n):
    for j in range(0, len(lst), n): 
        yield lst[j : j+n]


def relu(x):
    return np.maximum(0,x)


def exp_reg(x, multiplier):
    return np.exp(-multiplier * x)
